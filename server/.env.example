# 复制为 .env 后填入真实值，.env 不进 git
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=YOUR_KEY_HERE
LLM_MODEL=YOUR_MODEL_NAME

# 可选：Langfuse 可观测
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# 服务
APP_HOST=127.0.0.1
APP_PORT=8000

# PostgreSQL（本地 docker-compose 起的 csa_postgres，端口 5433，不占 5432）
# 生产环境改由部署平台注入环境变量，不要把真实口令写进这个文件
DATABASE_URL=postgresql://csa:YOUR_PASSWORD_HERE@127.0.0.1:5433/customer_service
DB_POOL_MIN=2
DB_POOL_MAX=20